source "https://rubygems.org"

# ==============================================================================
# SIMULASI KERENTANAN DEVSECOPS - TAHAP 1 (DEMO SCA VULNERABILITY SCANNER)
# Dependensi di bawah ini sengaja menggunakan versi lawas yang memiliki CVE publik
# untuk menguji deteksi Software Composition Analysis (SCA) oleh Trivy Scanner.
# ==============================================================================

# Jekyll 3.8.5 memiliki CVE-2020-14001 (Directory Traversal)
gem "jekyll", "3.8.5"

# Nokogiri 1.10.4 memiliki CVE-2019-5477, CVE-2020-26247 (Buffer Overflow & Command Injection)
gem "nokogiri", "1.10.4"

# Kramdown versi lama
gem "kramdown", "1.17.0"

# Server support
gem "webrick", "~> 1.7"
